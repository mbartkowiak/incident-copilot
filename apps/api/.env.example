APP_ENVIRONMENT=local
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_DATABRICKS_PROFILE=
APP_DATABRICKS_WAREHOUSE_ID=
ANTHROPIC_API_KEY=

# ServiceNow connector (optional). Use a dedicated integration user; keep the password out of git.
SERVICENOW_INSTANCE=https://devXXXXXX.service-now.com
SERVICENOW_USER=copilot.integration
SERVICENOW_PASSWORD=

# Shared secret the ServiceNow app sends with incident events and Copilot button calls
# (X-Copilot-Secret).
SERVICENOW_WEBHOOK_SECRET=

# Sign-in (optional). Without a user pool, auth is off and you act as a local user with every role.
# Values come from `terraform output` in infra/terraform.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=https://incident-copilot-327810701016.auth.us-east-1.amazoncognito.com
COGNITO_DEMO_PASSWORD=
